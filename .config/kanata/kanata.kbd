;; Miryoku-LITE для HyperX Alloy FPS Pro (TKL 80% ANSI, Cherry MX Red)
;; Home row mods (GASC) + CapsLock = Esc/NAV

(defcfg
  linux-dev /dev/input/by-id/usb-Kingston_HyperX_Alloy_FPS_Pro_Mechanical_Gaming_Keyboard-event-kbd
  process-unmapped-keys yes
)

(defvar
  tap-time 200
  hold-time 200
)

(defsrc
  esc       f1   f2   f3   f4    f5   f6   f7   f8    f9   f10  f11  f12    prnt slck pause
  grv  1    2    3    4    5     6    7    8    9     0    -    =    bspc   ins  home pgup
  tab  q    w    e    r    t     y    u    i    o     p    [    ]    \      del  end  pgdn
  caps a    s    d    f    g     h    j    k    l     ;    '    ret
  lsft z    x    c    v    b     n    m    ,    .     /    rsft                  up
  lctl lmet lalt                 spc                  ralt menu rctl      left  down right
)

(defalias
  ;; Home row mods (GASC — Miryoku дзеркальний порядок)
  ;; tap-hold-release: hold спрацьовує тільки якщо ви натиснули
  ;; І відпустили другу клавішу, поки тримаєте першу.
  ;; При rolling (відпускаєте першу раніше) — завжди tap.
  a (tap-hold-release $tap-time $hold-time a lmet)
  s (tap-hold-release $tap-time $hold-time s lalt)
  d (tap-hold-release $tap-time $hold-time d lctl)
  f (tap-hold-release $tap-time $hold-time f lsft)
  j (tap-hold-release $tap-time $hold-time j rsft)
  k (tap-hold-release $tap-time $hold-time k rctl)
  l (tap-hold-release $tap-time $hold-time l lalt)
  ; (tap-hold-release $tap-time $hold-time ; rmet)

  ;; CapsLock: коротко = Esc, утримати = NAV
  cap (tap-hold-release $tap-time $hold-time esc (layer-while-held nav))

  ;; Space: коротко = пробіл, утримати = SYM-шар
  spc (tap-hold-release $tap-time $hold-time spc (layer-while-held sym))
)

(deflayer base
  esc       f1   f2   f3   f4    f5   f6   f7   f8    f9   f10  f11  f12    prnt slck pause
  grv  1    2    3    4    5     6    7    8    9     0    -    =    bspc   ins  home pgup
  tab  q    w    e    r    t     y    u    i    o     p    [    ]    \      del  end  pgdn
  @cap @a   @s   @d   @f   g     h    @j   @k   @l   @;    '    ret
  lsft z    x    c    v    b     n    m    ,    .     /    rsft                  up
  lctl lmet lalt                 @spc                 ralt menu rctl      left  down right
)

;; NAV-шар: hjkl → стрілки, uiop → home/pgdn/pgup/end
(deflayer nav
  _         _    _    _    _     _    _    _    _     _    _    _    _      _    _    _
  _    _    _    _    _    _     _    _    _    _     _    _    _    _      _    _    _
  _    _    _    _    _    _     _    home pgdn pgup  end  _    _    _      _    _    _
  _    _    _    _    _    _     left down up   rght  _    _    _
  _    _    _    _    _    _     _    _    _    _     _    _                     _
  _    _    _                    _                    _    _    _         _    _    _
)

;; SYM-шар: ліва рука = символи, права рука = модифікатори (дзеркально HRM)
;; Активується утриманням Space
;;
;; Розкладка символів:
;;   Q W E R T      { & * ( }
;;   A S D F G      : $ % ^ +
;;   Z X C V B      ~ ! @ # |
;;
;; Права рука: _ _ _ _ _ + модифікатори на home row
;; Thumb: Space вже утримується, інші думби можна використати як ( ) _
(deflayer sym
  _         _    _    _    _     _    _    _    _     _    _    _    _      _    _    _
  _    _    _    _    _    _     _    _    _    _     _    _    _    _      _    _    _
  _    S-[  S-7  S-8  S-9  S-]   _    _    _    _     _    _    _    _      _    _    _
  _    S-;  S-4  S-5  S-6  =     _    rsft rctl lalt  rmet _    _
  _    S-`  S-1  S-2  S-3  S-\   _    _    _    _     _    _                     _
  _    _    _                    _                    _    _    _         _    _    _
)
